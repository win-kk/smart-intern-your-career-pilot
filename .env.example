PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=smartintern_db
SESSION_SECRET=replace_with_a_local_session_secret

# Local development uses memory sessions. Production requires Redis and HTTPS.
NODE_ENV=development
# Production only: use a private authenticated Redis service (rediss:// for TLS).
REDIS_URL=redis://127.0.0.1:6379
# Set to the exact trusted proxy hop count; 0 for direct HTTPS.
TRUST_PROXY_HOPS=0

# Production requires the exact browser origin (no trailing slash).
# PUBLIC_ORIGIN=https://smartintern.example.com
